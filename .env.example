# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 behind HTTPS (enables secure cookies, HSTS, SSL redirect).
DJANGO_HTTPS=0
DJANGO_SECURE_COOKIES=0
# PostgreSQL for deployed use and concurrency tests; SQLite is used when unset.
# DATABASE_URL=postgres://roombyroom:password@localhost:5432/roombyroom
DATABASE_URL=
# Private receipts/photos directory (outside static/media hosting).
PRIVATE_STORAGE_ROOT=
# Receipt extraction (Sprint 2). Leave empty: the app says extraction is not configured.
ANTHROPIC_API_KEY=
RECEIPT_MODEL=
