# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set to 1 behind HTTPS (enables secure cookies, HSTS, SSL redirect).
DJANGO_HTTPS=0
DJANGO_SECURE_COOKIES=0
# PostgreSQL for deployed use and concurrency tests; SQLite is used when unset.
# DATABASE_URL=postgres://roombyroom:password@localhost:5432/roombyroom
DATABASE_URL=
# Private receipts/photos: "filesystem" (local, PRIVATE_STORAGE_ROOT) or "database" (Render; see docs/deployment-render.md).
PRIVATE_STORAGE_BACKEND=filesystem
PRIVATE_STORAGE_ROOT=
# Receipt extraction. Both values are server-side only; leave the key empty and the app
# says "Automatic extraction not configured" while upload and manual review keep working.
ANTHROPIC_API_KEY=
RECEIPT_MODEL=claude-haiku-4-5-20251001
# "anthropic" (default) or "fake" (synthetic test extractor; never for real use).
RECEIPT_EXTRACTOR=anthropic
RECEIPT_TIMEOUT_SECONDS=60
RECEIPT_LEASE_SECONDS=180
RECEIPT_RETRY_DELAY_SECONDS=30
